# ─────────────────────────────────────────────────────────────
# MiitVerse — Vercel Container Image (Dockerfile.vercel)
# Vercel detects this file at the repo root, builds it, pushes
# the image to Vercel Container Registry (VCR), and routes ALL
# traffic to the container. The Express server serves both the
# built React frontend (server/public) and the /api routes.
#
# The container must listen on $PORT (injected by Vercel) and
# bind 0.0.0.0. Secrets (MongoDB / Neo4j / SendGrid / JWT) are
# injected at runtime from Vercel Environment Variables — they
# must NOT be baked into the image.
# ─────────────────────────────────────────────────────────────

# ---- Stage 1: Build the React/Vite frontend ----
FROM node:22-alpine AS frontend-builder

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

# Frontend reaches the API on the same origin through /api
# (see src/lib/api.js: import.meta.env.VITE_API_BASE_URL || '/api')
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN npm run build

# ---- Stage 2: Runtime — Node.js/Express server ----
FROM node:22-alpine AS runtime

WORKDIR /app

ENV NODE_ENV=production

# Install ONLY production server dependencies
COPY server/package*.json ./
RUN npm install --omit=dev

# Copy the backend source and the built frontend into server/public
COPY server ./server
COPY --from=frontend-builder /app/dist ./server/public

WORKDIR /app/server

# Vercel passes the port through $PORT. server.js uses
# process.env.PORT (default 3001) and binds 0.0.0.0.
EXPOSE 3001

CMD ["node", "src/server.js"]
