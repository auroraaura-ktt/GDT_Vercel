# ─────────────────────────────────────────────────────────────
# MiitVerse server — environment variables (EXAMPLE ONLY)
#
# Copy this file to `server/.env` for LOCAL development ONLY.
# For Vercel deployments, DO NOT commit a .env file. Instead add
# these same keys under:
#   Vercel → Project → Settings → Environment Variables
# (set them for Production, Preview, and Development as needed).
#
# The running container loads these from process.env; nothing is
# baked into the Docker image.
# ─────────────────────────────────────────────────────────────

# ── HTTP ──────────────────────────────────────────────────
# Vercel injects $PORT automatically. Leave unset for local (default 3001).
#PORT=3001
# Set to the actual frontend origin used by the deployed app.
# Default production origin for this repo is Vercel:
CLIENT_ORIGIN=https://miitverse-xi.vercel.app,https://gdt-vercel.vercel.app

# ── JWT ───────────────────────────────────────────────────
# Use a long, random string. REQUIRED for auth tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# ── MongoDB Atlas (primary user/account store) ─────────────
# Prefer a single MONGODB_URI connection string:
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/MiitVerse?retryWrites=true&w=majority
# ...or the individual parts (used when MONGODB_URI is empty):
#MONGODB_HOST=
#MONGODB_USERNAME=
#MONGODB_PASSWORD=
#MONGODB_DATABASE=MiitVerse
#MONGODB_PROTOCOL=mongodb+srv
#MONGODB_OPTIONS=retryWrites=true&w=majority&appName=Cluster0

# ── Neo4j Aura (graph store for users/posts) ───────────────
NEO4J_URI=neo4j+s://YOUR_INSTANCE.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD

# ── Email (SendGrid) ───────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@miitverse.com
SENDGRID_FROM_NAME=MiitVerse Authentication

# ── Options ────────────────────────────────────────────────
# Set to "true" to skip Neo4j initialization at boot (MongoDB-only mode).
#SKIP_DB=false
